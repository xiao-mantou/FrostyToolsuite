<ctrl:FrostyDockableWindow x:Class="FrostyEditor.Windows.ModTrimWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls" Title="Trim Frosty Mod" Width="760" Height="560">
  <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><Button Content="Import .fbmod" Width="110" Click="OpenButton_Click"/><Button Content="Select all" Width="90" Margin="8,0,0,0" Click="SelectAll_Click"/><Button Content="Clear" Width="70" Margin="8,0,0,0" Click="Clear_Click"/><TextBlock x:Name="sourceText" Margin="12,4,0,0" Text="No Mod loaded"/></DockPanel>
    <ListView x:Name="resourceList" Grid.Row="1"><ListView.View><GridView><GridViewColumn Header="Keep" Width="55"><GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Keep}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Type}"/><GridViewColumn Header="Name" Width="560" DisplayMemberBinding="{Binding Name}"/></GridView></ListView.View></ListView>
    <DockPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock x:Name="statusText"/><Button Content="Save trimmed Mod" Width="140" HorizontalAlignment="Right" Click="SaveButton_Click"/></DockPanel>
  </Grid>
</ctrl:FrostyDockableWindow>
