<ctrl:FrostyDockableWindow x:Class="FrostyEditor.Windows.ModTrimWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls" xmlns:local="clr-namespace:FrostyEditor.Windows" Title="Trim Frosty Mod" Width="760" Height="560">
  <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><Button Content="Import .fbmod" Width="110" Click="OpenButton_Click"/><Button Content="Select all" Width="90" Margin="8,0,0,0" Click="SelectAll_Click"/><Button Content="Clear" Width="70" Margin="8,0,0,0" Click="Clear_Click"/><Button Content="Select all CHK" Width="105" Margin="8,0,0,0" Click="SelectAllChunks_Click"/><Button Content="Clear CHK" Width="85" Margin="8,0,0,0" Click="ClearChunks_Click"/><TextBlock x:Name="sourceText" Margin="12,4,0,0" Text="No Mod loaded"/></DockPanel>
    <TreeView x:Name="resourceTree" Grid.Row="1" ItemTemplate="{DynamicResource TreeTemplate}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
      <TreeView.Resources>
        <HierarchicalDataTemplate x:Key="TreeTemplate" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal"><CheckBox IsThreeState="True" IsChecked="{Binding Keep, Mode=TwoWay}" Checked="ResourceCheckBox_Changed" Unchecked="ResourceCheckBox_Changed" Indeterminate="ResourceCheckBox_Changed"/><Image Source="{Binding TypeIcon}" Height="16" Width="16" Margin="5,0,0,0"/><TextBlock Text="{Binding DisplayName}" Foreground="{Binding DisplayBrush}" Margin="6,0,0,0"/></StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.Resources>
    </TreeView>
    <DockPanel Grid.Row="2" Margin="0,8,0,0"><ProgressBar x:Name="scanProgress" Width="180" Height="16" Minimum="0" Maximum="100" Visibility="Collapsed"/><TextBox x:Name="statusText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="8,0,0,0"/><Button x:Name="cancelScanButton" Content="Cancel scan" Width="90" HorizontalAlignment="Right" Visibility="Collapsed" Click="CancelScanButton_Click"/><Button Content="Save trimmed Mod" Width="140" HorizontalAlignment="Right" Click="SaveButton_Click"/></DockPanel>
    <TextBox x:Name="reportText" Grid.Row="3" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
  </Grid>
</ctrl:FrostyDockableWindow>
